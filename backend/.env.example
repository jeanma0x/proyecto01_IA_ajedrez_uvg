# Cadena de conexión de Neon (Postgres serverless). Nunca commitear la real.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Orígenes del frontend permitidos para CORS (separados por coma).
FRONTEND_ORIGINS="http://localhost:5173"

# Claves de los 3 proveedores de IA — ver docs/04-MODELOS_PENDIENTE.md.
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Usada solo por el modo comentarista (lib/commentary.ts), no por un
# participante jugable — ver docs/04-MODELOS_PENDIENTE.md.
GROQ_API_KEY=""
